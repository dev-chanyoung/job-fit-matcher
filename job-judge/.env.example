# ANTHROPIC_API_KEY is only needed for the fully-automated judge.py CLI
# (normalizer.py/evaluator.py call the Anthropic API directly, billed
# separately from a Claude Code Pro/Max subscription).
# If you're using judge_manual.py instead (a Claude Code session does the
# normalize/evaluate steps in-conversation, no separate API billing),
# you can leave this blank and only fill in the two Notion keys below.
ANTHROPIC_API_KEY=
NOTION_API_KEY=
NOTION_DB_ID=

# jasoseol_watcher.py 전용. 미설정 시 신규 공고를 콘솔에만 출력하고 Discord 전송은 생략.
DISCORD_WEBHOOK_URL=
