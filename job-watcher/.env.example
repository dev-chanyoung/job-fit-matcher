# MongoDB Atlas 연결 문자열 (job_watcher 데이터베이스/seen_postings 컬렉션에 저장)
MONGODB_URI=

# Discord 웹훅 URL. 미설정 시 신규 공고를 찾아도 알림 없이 상태만 저장한다.
DISCORD_WEBHOOK_URL=

# Notion 연동 (job-judge와 같은 값 사용). 최초 실행 시 이미 등록된 회사를
# 자동으로 시드(=알림 제외)하는 데만 쓰인다.
NOTION_API_KEY=
NOTION_DB_ID=

# Vercel Cron Job 요청 인증용 무작위 문자열. Vercel 프로젝트 환경변수에도
# 동일한 값을 등록해야 한다 (등록 시 Vercel이 자동으로 Authorization 헤더에
# "Bearer <값>"을 실어서 보내준다). 비워두면 로컬 실행에서만 인증 검사를
# 건너뛰고, Vercel 배포 환경에서는 모든 요청을 거부한다 -- 배포에는 반드시 채워 넣을 것.
CRON_SECRET=
